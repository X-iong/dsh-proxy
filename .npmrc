# Reproducible installs for the dsh-proxy toolchain.
#
# @deepseek-ai/dsh-client-runtime declares ~16 @deepseek-ai/* peer dependencies
# that would drag in the whole harness graph. We only need its types for one
# import subpath, and the pnpm mirror of these two settings lives in
# pnpm-workspace.yaml (`autoInstallPeers` / `strictPeerDependencies`) because
# pnpm >= 11 no longer reads them from .npmrc. They are kept here as well so a
# plain `npm install` in a pinch behaves the same.
auto-install-peers=false
strict-peer-dependencies=false
